# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.
# On Azure App Service the same settings are App Settings, using double underscores:
#   Jwt__SigningKey, ConnectionStrings__Default, AI__ApiKey, Integrations__TeamsWebhookUrl, ...
# Locally without Docker, use `dotnet user-secrets` or environment variables instead.

# --- Required for docker compose ---
# SQL Server password: 8+ chars with upper, lower, digit and symbol.
SQL_SA_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=

# --- AI triage (optional: leave AI_API_KEY empty for offline mock mode) ---
# Mock | OpenAI | AzureOpenAI
AI_PROVIDER=Mock
AI_API_KEY=
# Azure OpenAI only, e.g. https://my-resource.openai.azure.com
AI_ENDPOINT=
# OpenAI model names, or Azure OpenAI deployment names
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# --- Integrations (optional) ---
# Teams "Workflows" incoming webhook URL. Empty = notifications are logged only.
TEAMS_WEBHOOK_URL=
# Shared secret for POST /api/integrations/email/inbound. Empty = endpoint disabled.
INBOUND_EMAIL_SECRET=
